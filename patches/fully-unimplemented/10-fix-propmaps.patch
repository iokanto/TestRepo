+package eu.faircode.xlua.x.xlua.hook;
+
+import androidx.annotation.NonNull;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import eu.faircode.xlua.x.Str;
+import eu.faircode.xlua.x.data.JsonHelperEx;
+import eu.faircode.xlua.x.data.string.StrBuilder;
+import eu.faircode.xlua.x.data.utils.ListUtil;
+import eu.faircode.xlua.x.xlua.interfaces.IJsonType;
+
+/**
+ * Maps a friendly/grouped "settingName" (e.g. "device.brand", the name shown in a SettingsContainer
+ * built from settingdefaults.json) to the actual, raw property names (e.g. "ro.product.brand",
+ * "ro.product.manufacturer") that individual hooks declare in their own "settings" list
+ * (assets/*hooks.json -> XHook.settings, consumed by HooksSettingsGlobal.init()).
+ * <p>
+ * Without this translation, HooksSettingsGlobal.getHookIdsForSettings(context, ["device.brand"])
+ * never finds anything: no hook lists "device.brand" itself in its "settings" array, only the raw
+ * property names it actually hooks. That mismatch is exactly why the "hook menu" button
+ * (ivBtHookMenu, ?attr/hookMenu) always found getCount() == 0 and showed the "---" placeholder /
+ * "no hooks" error instead of opening the assign-hooks dialog.
+ */
+public class PropMapEntry implements IJsonType {
+    public static final String JSON = "propmaps.json";
+
+    public static final String FIELD_SETTING_NAME = "settingName";
+    public static final String FIELD_PROP_NAMES = "propNames";
+
+    public String settingName;
+    public final List<String> propNames = new ArrayList<>();
+
+    @Override
+    public String toJSONString() throws JSONException { return toJSONObject().toString(); }
+
+    @Override
+    public JSONObject toJSONObject() throws JSONException {
+        JSONObject obj = new JSONObject();
+        obj.put(FIELD_SETTING_NAME, this.settingName);
+        obj.put(FIELD_PROP_NAMES, new JSONArray(this.propNames));
+        return obj;
+    }
+
+    @Override
+    public void fromJSONObject(JSONObject obj) throws JSONException {
+        if(obj != null) {
+            this.settingName = obj.optString(FIELD_SETTING_NAME);
+            ListUtil.addAll(this.propNames, JsonHelperEx.getStringArrayAsList(obj, FIELD_PROP_NAMES), true);
+        }
+    }
+
+    @NonNull
+    @Override
+    public String toString() {
+        return StrBuilder.create()
+                .appendFieldLine(FIELD_SETTING_NAME, this.settingName)
+                .appendDividerTitleLine(Str.combineEx(FIELD_PROP_NAMES, "[", this.propNames.size(), "]"))
+                .appendLine(this.propNames, Str.NEW_LINE)
+                .toString(true);
+    }
+}
