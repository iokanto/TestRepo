+    private static List<AppXpPacket> getLocalAppsDirectly(Context context) {
+        List<AppXpPacket> localApps = new ArrayList<>();
+        PackageManager pm = context.getPackageManager();
+        String selfPackage = context.getPackageName(); // XPL-EX's own package name
+
+        List<PackageInfo> packages = pm.getInstalledPackages(PackageManager.GET_META_DATA);
+
+        for (PackageInfo pi : packages) {
+            if (pi.applicationInfo == null) continue;
+
+            if (pi.packageName.equals(selfPackage)) {
+                continue;
+            }
+
+            AppXpPacket app = new AppXpPacket();
+            app.packageName = pi.packageName;
+            app.label = pi.applicationInfo.loadLabel(pm).toString();
+            app.uid = pi.applicationInfo.uid;
+            app.system = (pi.applicationInfo.flags & android.content.pm.ApplicationInfo.FLAG_SYSTEM) != 0;
+            app.enabled = pi.applicationInfo.enabled;
+            app.icon = pi.applicationInfo.icon;
+
+            localApps.add(app);
+        }
+
+        return localApps;
+    }
