diff --git a/app/src/main/java/eu/faircode/xlua/SafeXposed.java b/app/src/main/java/eu/faircode/xlua/SafeXposed.java
new file mode 100644
index 0000000..28fc963
--- /dev/null
+++ b/app/src/main/java/eu/faircode/xlua/SafeXposed.java
@@ -0,0 +1,49 @@
+package eu.faircode.xlua;
+
+/**
+ * Confirmed by logcat: in this build, "de.robv.android.xposed.XposedBridge" does not exist
+ * anywhere in the apk's classpath at all -
+ *   java.lang.ClassNotFoundException: Didn't find class "de.robv.android.xposed.XposedBridge"
+ *   on path: DexPathList[[zip file ".../base.apk"], ...]
+ * The codebase calls XposedBridge.log(...) unconditionally in dozens of places, including deep
+ * inside database/hook initialization (XLuaDatabaseManager, XLegacyCore's own log wrappers, etc).
+ * Any one of those calls throws NoClassDefFoundError the first time it's reached, which is why the
+ * "settings"/"hook" tables were never even created ("no such table: settings" in logcat) and the
+ * Hooks list stayed empty - not because of a routing/process/parsing problem, but because
+ * initialization was crashing before it got anywhere near that code.
+ * <p>
+ * This class centralizes every one of those call sites behind a single, cheap, one-time
+ * availability check. If XposedBridge really is available (e.g. this same code running inside an
+ * actually-hooked target app's process under a real Xposed/LSPatch module load), it behaves
+ * exactly as before. If it isn't, every call becomes a harmless no-op instead of a crash.
+ */
+public final class SafeXposed {
+    private SafeXposed() {}
+
+    private static final boolean AVAILABLE = checkAvailable();
+
+    private static boolean checkAvailable() {
+        try {
+            Class.forName("de.robv.android.xposed.XposedBridge");
+            return true;
+        } catch (Throwable t) {
+            return false;
+        }
+    }
+
+    public static boolean isAvailable() { return AVAILABLE; }
+
+    public static void log(String msg) {
+        if (!AVAILABLE) return;
+        try {
+            de.robv.android.xposed.XposedBridge.log(msg);
+        } catch (Throwable ignored) { }
+    }
+
+    public static void log(Throwable ex) {
+        if (!AVAILABLE) return;
+        try {
+            de.robv.android.xposed.XposedBridge.log(ex);
+        } catch (Throwable ignored) { }
+    }
+}
